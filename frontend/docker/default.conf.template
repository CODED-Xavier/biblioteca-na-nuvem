server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # config.js nunca em cache (contém a URL da API)
  location = /config.js {
    add_header Cache-Control "no-store";
  }

  # Fallback do React Router / SPA
  location / {
    try_files $uri $uri/ /index.html;
  }
}
